<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        app:srcCompat="@drawable/ic_grip"
        app:tint="?colorControlNormal" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/typeBackArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="?colorControlNormal" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/typeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/filter_root_dialog_type_item_title"
            android:textAppearance="?textAppearanceSubtitle1"
            app:layout_constraintStart_toEndOf="@id/typeBackArrow"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/typeBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/typeTitle"
            app:layout_constraintTop_toBottomOf="@id/typeTitle" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/filterTypeReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginEnd="16dp"
            android:text="@string/filter_dialog_reset_action"
            android:textAppearance="?textAppearanceBody2"
            android:textColor="@color/color_overlay_violet"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@id/typeTitle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        layout="@layout/view_divider_vertical"
        android:layout_width="match_parent"
        android:layout_height="?dividerVerticalSize"
        android:layout_margin="16dp" />

    <CheckBox
        android:id="@+id/courseCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="@string/filter_dialog_type_course"
        android:textAppearance="?textAppearanceBody1" />

    <CheckBox
        android:id="@+id/programCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="@string/filter_dialog_type_program"
        android:textAppearance="?textAppearanceBody1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/applyFilterAction"
        style="@style/Widget.AppTheme.Button"
        android:layout_width="match_parent"

        android:layout_height="wrap_content"
        android:layout_margin="16dp"

        android:text="@string/filter_dialog_apply"
        android:theme="@style/ThemeOverlay.Violet" />
</androidx.appcompat.widget.LinearLayoutCompat>